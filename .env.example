# ── Required ──
# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# ── Optional ──
# Port the API / production server listens on (default 3001)
PORT=3001

# Where the SQLite database lives. Point this at a persistent volume in production.
# On first boot the bundled server/auxnet.db is copied there if the volume is empty.
# DB_PATH=/data/auxnet.db

# Set to 1 (or a hop count) when running behind a reverse proxy / load balancer so
# per-IP rate limiting sees the real client address.
# TRUST_PROXY=1

# Comma-separated list of origins allowed to call the API cross-origin.
# Leave unset when the site and API share an origin (the default setup).
# CORS_ORIGIN=https://yugen.example.com

# NODE_ENV=production
